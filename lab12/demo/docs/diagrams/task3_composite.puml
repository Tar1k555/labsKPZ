@startuml task3_composite
skinparam classAttributeIconSize 0

interface CargoComponent <<Component>> {
  + getName() : String
  + getWeight() : double
  + getDeclaredValue() : double
  + getShipmentCount() : int
  + printTree(indent : String) : void
}

class Parcel <<Leaf>> {
  - waybillNumber : String
  - description : String
  - weightKg : double
  - declaredValue : double
  + Parcel(waybillNumber : String, description : String, weightKg : double, declaredValue : double)
  + getName() : String
  + getWeight() : double
  + getDeclaredValue() : double
  + getShipmentCount() : int
  + printTree(indent : String) : void
}

class CargoContainer <<Composite>> {
  - containerType : String
  - code : String
  - children : List<CargoComponent>
  + CargoContainer(containerType : String, code : String)
  + add(component : CargoComponent) : void
  + remove(component : CargoComponent) : void
  + getName() : String
  + getWeight() : double
  + getDeclaredValue() : double
  + getShipmentCount() : int
  + printTree(indent : String) : void
}

class Main <<Client>>

CargoComponent <|.. Parcel
CargoComponent <|.. CargoContainer
CargoContainer o-- "0..*" CargoComponent : агрегує (мішок у мішку)
Main ..> CargoComponent : працює через спільний інтерфейс

note right of CargoContainer
  Рекурсивно підсумовує вагу,
  вартість та кількість для будь-якої
  глибини вкладеності.
end note
@enduml